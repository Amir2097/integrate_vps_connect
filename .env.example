# ============== БАЗА ДАННЫХ ==============
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Локально: хост localhost. На VPS: localhost если PostgreSQL на той же машине, иначе IP/домен сервера БД.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vpn_manager

# ============== АДМИНКА ==============
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=

# JWT (секрет для подписи токенов; на проде — длинная случайная строка)
JWT_SECRET=your-secret-key-change-in-production

# ============== TELEGRAM BOT ==============
BOT_TOKEN=your_bot_token_from_BotFather

# URL, по которому бот дергает API. Локально: http://localhost:8000. На VPS: https://твой-домен или http://127.0.0.1:8000
BACKEND_URL=http://localhost:8000

# Telegram ID админа: сюда приходят уведомления о новой заявке и «Я оплатил». Узнать свой ID: напиши боту @userinfobot
ADMIN_TELEGRAM_ID=615110136

# Секрет для внутренних вызовов бот↔бэкенд (подтверждение оплаты кнопками в Telegram). Задай длинную случайную строку.
INTERNAL_SECRET=unternal-sample-secret

# ============== WIREGUARD (только на VPS, где крутится приложение рядом с WG) ==============
# Путь к скрипту add-wg-client.sh. Локально оставь пустым — будет мок (конфиги не реальные).
WG_SCRIPT_PATH=
WG_CONF_PATH=/etc/wireguard/wg0.conf
WG_CLIENTS_DIR=/etc/wireguard/clients
# Публичный IP или домен VPS с WireGuard (подставляется в конфиг клиента в Endpoint)
SERVER_ENDPOINT=82.117.84.212
WG_PORT=51820

# Срок подписки в днях после подтверждения оплаты
SUBSCRIPTION_DAYS=30
# Сумма за один конфиг (₽), для отображения в админке
SUBSCRIPTION_AMOUNT=100
