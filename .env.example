# ============== БАЗА ДАННЫХ ==============
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Локально: хост localhost. На VPS: localhost если PostgreSQL на той же машине.
# На проде задай надёжный пароль БД.
DATABASE_URL=postgresql+asyncpg://postgres:vpnapp200997@localhost:5432/vpn_manager

# ============== АДМИНКА ==============
ADMIN_LOGIN=admin
# Хэш пароля: python -c "from app.auth import hash_password; print(hash_password('пароль'))"
ADMIN_PASSWORD_HASH=

# JWT (секрет для подписи токенов). На проде: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-in-production

# ============== TELEGRAM BOT ==============
BOT_TOKEN=your_bot_token_from_BotFather

# URL, по которому бот дергает API. Локально: http://localhost:8000. На VPS: https://твой-домен или http://127.0.0.1:8000
BACKEND_URL=http://localhost:8000

# Telegram ID админа: сюда приходят уведомления о новой заявке и «Я оплатил». Узнать свой ID: напиши боту @userinfobot
ADMIN_TELEGRAM_ID=615110136

# Секрет для внутренних вызовов бот↔бэкенд. На проде: своя длинная случайная строка (одна и та же на сервере).
INTERNAL_SECRET=unternal-sample-secret

# ============== WIREGUARD (только на VPS, где крутится приложение рядом с WG) ==============
# Путь к скрипту add-wg-client.sh. Локально оставь пустым — будет мок (конфиги не реальные).
WG_SCRIPT_PATH=/usr/local/bin/add-wg-client.sh
WG_CONF_PATH=/etc/wireguard/wg0.conf
WG_CLIENTS_DIR=/etc/wireguard/clients
# true = запуск через sudo. false = запуск от пользователя процесса (если у пользователя, например amir, есть прямые права на скрипт и /etc/wireguard)
WG_USE_SUDO=false
# Публичный IP или домен VPS с WireGuard (подставляется в конфиг клиента в Endpoint)
SERVER_ENDPOINT=core.dautovtech.ru
WG_PORT=51820

# Срок подписки в днях после подтверждения оплаты
SUBSCRIPTION_DAYS=30
# Сумма за один конфиг (₽), для отображения в админке и боте
SUBSCRIPTION_AMOUNT=100
# Номер телефона для перевода (СБП/банк). Если пусто — в боте «уточните у администратора»
PAYMENT_PHONE=
